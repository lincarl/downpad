{
  "name": "downpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, pure-WYSIWYG markdown editor",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:desktop",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "tsc -p electron/tsconfig.json && node scripts/build-desktop.mjs",
    "check": "tsc --noEmit && tsc -p electron/tsconfig.json && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "start": "electron .",
    "icons": "node scripts/generate-icons.mjs",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --publish never",
    "test": "vitest run && pnpm test:version && pnpm test:icons && pnpm test:desktop && pnpm test:ci && pnpm test:release",
    "test:version": "node --test scripts/apply-version-from-tag.test.mjs",
    "test:icons": "node --test scripts/icons.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:desktop": "vitest run --config electron/vitest.config.ts",
    "test:ci": "node --test scripts/ci.test.mjs scripts/run-msi-test.test.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "7.22.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.7.0",
    "toml-eslint-parser": "^1.0.3",
    "turndown": "^7.2.4"
  },
  "main": "electron-dist/main.js",
  "license": "MIT",
  "author": {
    "name": "Downpad contributors"
  },
  "build": {
    "appId": "se.elysics.downpad",
    "productName": "Downpad",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "build/icon.png"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "msiProjectCreated": "./scripts/brand-msi.mjs",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons",
      "executableName": "downpad",
      "maintainer": "Downpad contributors",
      "syncDesktopName": true
    },
    "deb": {
      "fpm": [
        "--conflicts",
        "md-easy",
        "--replaces",
        "md-easy",
        "build/linux/md-easy.desktop=/usr/share/applications/md-easy.desktop"
      ]
    },
    "win": {
      "target": [
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "upgradeCode": "E35FC5B3-CF65-509C-8B7E-6FC85FF408B6"
    },
    "appx": {
      "backgroundColor": "transparent"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "npmRebuild": false
  },
  "homepage": "https://github.com/lincarl/downpad",
  "repository": {
    "type": "git",
    "url": "https://github.com/lincarl/downpad.git"
  },
  "desktopName": "downpad.desktop",
  "engines": {
    "node": ">=26.12.1"
  }
}
