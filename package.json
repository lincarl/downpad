{
  "name": "md-easy",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A lightweight, pure-WYSIWYG markdown editor",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:desktop",
    "build:web": "tsc --noEmit && vite build",
    "build:desktop": "tsc -p electron/tsconfig.json && node scripts/build-desktop.mjs",
    "check": "tsc --noEmit && tsc -p electron/tsconfig.json && pnpm lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "start": "electron .",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --publish never",
    "test": "vitest run && pnpm test:version && pnpm test:desktop && pnpm test:reviewed-ci",
    "test:version": "node --test scripts/apply-version-from-tag.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:desktop": "vitest run --config electron/vitest.config.ts",
    "test:reviewed-ci": "node --test scripts/reviewed-ci.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "7.21.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.35.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.6.0",
    "toml-eslint-parser": "^1.0.3",
    "turndown": "^7.2.4"
  },
  "main": "electron-dist/main.js",
  "license": "MIT",
  "author": {
    "name": "md-easy contributors"
  },
  "build": {
    "appId": "se.elysics.md-easy",
    "productName": "md-easy",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "build/icon.png"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "md-easy",
      "maintainer": "md-easy contributors",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "npmRebuild": false
  },
  "homepage": "https://github.com/lincarl/md-easy",
  "repository": {
    "type": "git",
    "url": "https://github.com/lincarl/md-easy.git"
  },
  "desktopName": "md-easy.desktop"
}
